# 텍스트 파일은 저장소에 LF로 보관한다 (체크아웃 시 OS에 맞게 변환).
* text=auto

# ── Unity YAML ──
# 씬/에셋/프리팹은 YAML이지만 일반 텍스트 병합은 GUID 블록을 뒤섞어 파일을 깨뜨린다.
# UnityYAMLMerge(스마트 머지)를 쓰려면 아래 merge=unityyamlmerge가 필요하고,
# 설정 전까지는 충돌 시 수동 해결한다.
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta      text eol=lf
*.cs        text eol=lf diff=csharp

# ── 바이너리 ──
*.png       binary
*.jpg       binary
*.psd       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.dll       binary
*.unitypackage binary
